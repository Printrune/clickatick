# Local previews require no credentials. Keep secrets in ignored .env.local or Vercel settings.
LOCAL_MODE=false
AI_ENABLED=false
AI_PROVIDER=anthropic
# Supported models: claude-sonnet-5-5 or claude-haiku-4-5-20251001. No automatic fallback.
AI_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# Confirm a dedicated total allowance of at most USD 10 with no automatic refills before setting true.
ANTHROPIC_BUDGET_CONFIRMED=false
PUBLISHING_ENABLED=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Organizer Phase A1. Configure both Clerk keys and a fresh Neon database before use.
# The public marketplace and legacy demo continue when these are blank.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
DATABASE_URL=

# Optional Phase A2 prototype picker. Use a browser key restricted to this site's domains.
# Without it, organizers can enter exact coordinates and open the public map link.
NEXT_PUBLIC_GOOGLE_MAPS_DEMO_KEY=

# Keep private media controls off until the owner approves storage and upload limits
# and the server routes, private Blob store and Neon migration are verified.
NEXT_PUBLIC_PRIVATE_MEDIA_ENABLED=false
# Server-only credential for the private Blob store. Backend writes remain code-gated
# until the owner approves quotas and the connected service is verified.
BLOB_READ_WRITE_TOKEN=

# New Neon demo catalog remains off until connected end-to-end verification.
NEXT_PUBLIC_NEON_DEMO_CATALOG_ENABLED=false

# New Neon zero-charge quote/checkout stays off until connected end-to-end checks pass.
DEMO_CHECKOUT_ENABLED=false
# Server-only creator-to-Neon cutover. Keep false until connected Clerk/Neon and
# the new owner-review publishing path pass end-to-end verification.
CREATOR_NEON_CUTOVER_ENABLED=false
# Optional server-only demo abuse limits. Defaults are documented in backend/integrated-phase-a4-implementation-v1.md.
# DEMO_QUOTES_PER_COOKIE_HOUR=12
# DEMO_QUOTES_PER_EVENT_HOUR=240
# DEMO_QUOTES_NO_COOKIE_PER_EVENT_HOUR=48
# DEMO_QUOTES_GLOBAL_HOUR=1000
# DEMO_CHECKOUTS_PER_COOKIE_DAY=4
# DEMO_CHECKOUTS_PER_EVENT_DAY=80
# DEMO_CHECKOUTS_NO_COOKIE_PER_EVENT_DAY=16
# DEMO_CHECKOUTS_GLOBAL_DAY=300
# DEMO_READS_PER_EVENT_HOUR=600


# A5 storefront and private-link staff access stay disabled until migration 006,
# Clerk, Neon and connected end-to-end checks are verified.
STOREFRONT_ENABLED=false
STAFF_INVITES_ENABLED=false
# Server-only, stable random secret of at least 32 bytes; never use NEXT_PUBLIC_.
INVITE_TOKEN_SECRET=

# A3 v6 direct media. All remain off until connected Blob and database verification.
MEDIA_V6_CONNECTED_VERIFIED=false
MEDIA_V6_IMAGE_UPLOAD_ENABLED=false
MEDIA_ALL_WRITERS_COORDINATED=false
MEDIA_BLOB_STORE_ID=
# Video upload and public playback remain disabled separately.
MEDIA_V6_VIDEO_UPLOAD_ENABLED=false
MEDIA_V6_VIDEO_PLAYBACK_ENABLED=false

# A6 seat authoring and in-place published revisions require migration 007,
# connected Clerk/Neon/media checks, and an explicit activation review.
SEAT_AUTHORING_ENABLED=false
NEXT_PUBLIC_SEAT_AUTHORING_ENABLED=false
PUBLISHED_REVISIONS_ENABLED=false
NEXT_PUBLIC_PUBLISHED_REVISIONS_ENABLED=false
